    document.title = TITLE0.replace("\u68a6\u5e7b\u6a31\u82b1\u6781\u5149\u684c\u9762\u65f6\u949f", TAIL[lang]);
    // 徽标：全新升级（从原文替换，支持反复切换）
    var tags = document.querySelectorAll(".tag");
    for (var i = 0; i < tags.length; ++i) {
      if (TAG0[i] === undefined) TAG0[i] = tags[i].textContent;
      if (TAG0[i].indexOf(BADGE_NEW.zh) >= 0)
        tags[i].textContent = TAG0[i].replace(BADGE_NEW.zh, BADGE_NEW[lang]);
    }
    // 文本节点替换（兼容混排元素里的裸文本；从中文原文可逆翻译）
    var walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);
    var nodes = [];
    while (walker.nextNode()) nodes.push(walker.currentNode);
    for (var j = 0; j < nodes.length; ++j) {
      var tn = nodes[j];
      var pTag = tn.parentNode && tn.parentNode.nodeName;
      if (pTag === "SCRIPT" || pTag === "STYLE") continue;
      var o = NODE0[j];
      if (o === undefined) {
        var k0 = (tn.nodeValue || "").trim();
        if (k0 && I18N[k0]) { o = { k: k0, r: tn.nodeValue }; NODE0[j] = o; }
      }
      if (!o) continue;
      var row = I18N[o.k];
      if (!row) continue;
      var v = (lang === "zh") ? o.r : o.r.replace(o.k, row[lang] || row.en || o.k);
      if (v !== tn.nodeValue) tn.nodeValue = v;
    }
    // 更新日志标题
    var cw = CHANGELOG_WORD[lang], rl = RELEASED[lang];
    var heads = document.querySelectorAll("section h2");
    for (var k = 0; k < heads.length; ++k) {
      var h = heads[k];
      var mt = h.textContent.match(/^(\u66f4\u65b0\u65e5\u5fd7|Changelog|\u66f4\u65b0\u5c65\u6b74|\ubcc0\uacfd \ub85c\uadf8)\s*\u00b7\s*(v[\d.]+)/);
      if (mt) h.childNodes[0].nodeValue = cw + " \u00b7 " + mt[2] + " ";
      var sp = h.querySelector("span");
      if (sp) {
        var md = sp.textContent.match(/\uff08\s*([\d-]+)\s*\u53d1\u5e03\s*\uff09|\uff08\s*([\d-]+)\s+released\s*\uff09|\(\s*released\s+([\d-]+)\s*\)|\uff08\s*([\d-]+)\s+\u516c\u958b\s*\uff09|\uff08\s*([\d-]+)\s+\ucd9c\uc2dc\s*\uff09/);
        if (md) {
          var d = md[1] || md[2] || md[3] || md[4] || md[5];
          sp.textContent = lang === "zh" ? "\uff08" + d + " \u53d1\u5e03\uff09"
            : lang === "en" ? "(released " + d + ")"
            : lang === "ja" ? "\uff08" + d + " \u516c\u958b\uff09"
            : "(" + d + " \ucd9c\uc2dc)";
        }
      }
    }
    // 更新日志区域提示
    var sec = document.querySelector("section[id^=changelog]");
    if (sec && lang !== "zh") {
      var note = document.getElementById("i18nNotice");
      if (!note) {
        note = document.createElement("p");
        note.id = "i18nNotice";
        note.style.cssText = "color:#a6a6b8;font-size:.85rem;margin:6px 0 0 2px;";
        sec.parentNode.insertBefore(note, sec);
      }
      note.textContent = NOTICE[lang] || NOTICE.en;
    } else {
      var old = document.getElementById("i18nNotice");
      if (old) old.parentNode.removeChild(old);
    }
    // 切换按钮状态
    var bar = document.getElementById("langBar");
    if (bar) {
      var btns = bar.querySelectorAll("button");
      for (var b = 0; b < btns.length; ++b)
        btns[b].className = (btns[b].getAttribute("data-l") === lang) ? "on" : "";
    }
  }

  function buildBar() {
    var header = document.querySelector("header");
    if (!header) return;
    header.style.position = "relative";
    var bar = document.createElement("div");
    bar.id = "langBar";
    for (var i = 0; i < LANGS.length; ++i) {
      var b = document.createElement("button");
      b.setAttribute("data-l", LANGS[i]);
      b.textContent = LANG_LABEL[LANGS[i]];
      b.onclick = (function (l) {
        return function () {
          lang = l;
          try { localStorage.setItem("xnj_lang", l); } catch (e) {}
          apply();
        };
      })(LANGS[i]);
      bar.appendChild(b);
    }
    header.appendChild(bar);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", function () { buildBar(); apply(); });
  } else { buildBar(); apply(); }
})();
</script>
</body>
</html>
