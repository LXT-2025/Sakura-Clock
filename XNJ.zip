  var lang = "zh";
  try {
    var qs = new URLSearchParams(location.search).get("lang");
    if (qs && LANGS.indexOf(qs) >= 0) lang = qs;
  } catch (e) {}
  try {
    var saved = (lang !== "zh") ? lang : localStorage.getItem("xnj_lang");
    if (saved && LANGS.indexOf(saved) >= 0) lang = saved;
    else {
      var nav = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || "en"]);
      for (var i = 0; i < nav.length; ++i) {
        var l = (nav[i] || "").toLowerCase();
        if (l.indexOf("zh") === 0) { lang = "zh"; break; }
        if (l.indexOf("ja") === 0) { lang = "ja"; break; }
        if (l.indexOf("ko") === 0) { lang = "ko"; break; }
        if (l.indexOf("en") === 0) { lang = "en"; break; }
      }
    }
  } catch (e) {}

  function tr(text) {
    var row = I18N[text];
    if (!row) return null;
    return row[lang] || row.en || null;
  }

  // 可逆切换：记住每个节点的中文原文，之后每次都从原文重新翻译
  var TITLE0 = document.title;
  var TAG0 = [];   // element -> 徽标原文
  var NODE0 = [];  // text node -> { k: 原文键, r: 原始 nodeValue }

  function apply() {
    document.documentElement.lang = lang === "zh" ? "zh-CN" : lang;
