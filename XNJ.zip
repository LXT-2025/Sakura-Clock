    <footer>Sakura & Aurora Dreamy Clock &copy; 2026 &nbsp;|&nbsp; Designed by <strong>LXT</strong></footer>

    <script>
        (function () {
            // ===== 实时走时预览 =====
            var weekZh = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"];
            var elTime = document.getElementById("previewTime");
            var elDate = document.getElementById("previewDate");
            function pad(n) { return n < 10 ? "0" + n : "" + n; }
            function tick() {
                var now = new Date();
                elTime.textContent = pad(now.getHours()) + ":" + pad(now.getMinutes()) + ":" + pad(now.getSeconds());
                elDate.textContent = now.getFullYear() + "年" + pad(now.getMonth() + 1) + "月" + pad(now.getDate()) + "日   " + weekZh[now.getDay()];
            }
            tick();
            setInterval(tick, 1000);

            // ===== 预览卡樱花飘落动画（模拟主程序粒子） =====
            var canvas = document.getElementById("petalCanvas");
            if (!canvas.getContext) return;
            var ctx = canvas.getContext("2d");
            var petals = [];
            var COLORS = ["#ffc3da", "#ffdeec", "#faafd0"];
            var PETAL_COUNT = 18;
            function resize() {
                canvas.width = canvas.offsetWidth;
                canvas.height = canvas.offsetHeight;
            }
            function resetPetal(p, randomY) {
                p.x = Math.random() * canvas.width;
                p.y = randomY ? Math.random() * canvas.height : -20;
                p.speedY = 0.5 + Math.random() * 1.1;
                p.swayAmp = 10 + Math.random() * 22;
                p.swayFreq = 0.015 + Math.random() * 0.02;
                p.phase = Math.random() * Math.PI * 2;
                p.size = 4 + Math.random() * 4;
                p.angle = Math.random() * Math.PI * 2;
                p.angleSpeed = (Math.random() - 0.5) * 0.05;
                p.color = COLORS[Math.floor(Math.random() * COLORS.length)];
            }
            function init() {
                resize();
                petals = [];
                for (var i = 0; i < PETAL_COUNT; i++) {
                    var p = {};
                    resetPetal(p, true);
                    petals.push(p);
                }
            }
            function drawPetal(p) {
                var swayX = p.x + Math.sin(p.phase) * p.swayAmp;
                ctx.save();
                ctx.translate(swayX, p.y);
                ctx.rotate(p.angle);
                ctx.fillStyle = p.color;
                ctx.globalAlpha = 0.9;
                ctx.beginPath();
                // 与主程序一致：顶部带缺口的樱花瓣
                var s = p.size;
                ctx.moveTo(0, -s);
                ctx.quadraticCurveTo(s * 0.5, -s * 0.7, s * 0.6, 0);
                ctx.quadraticCurveTo(s * 0.55, s * 0.7, 0, s * 1.2);
                ctx.quadraticCurveTo(-s * 0.55, s * 0.7, -s * 0.6, 0);
                ctx.quadraticCurveTo(-s * 0.5, -s * 0.7, 0, -s);
                ctx.fill();
                ctx.restore();
            }
            function loop() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (var i = 0; i < petals.length; i++) {
                    var p = petals[i];
                    p.y += p.speedY;
                    p.phase += p.swayFreq;
                    p.angle += p.angleSpeed;
                    if (p.y > canvas.height + 20) resetPetal(p, false);
                    drawPetal(p);
                }
                requestAnimationFrame(loop);
            }
            init();
            loop();
            window.addEventListener("resize", init);
        })();
    </script>
